# Copy this file to .env for local dev (already gitignored) or paste these
# names into your hosting platform's "Environment Variables" dashboard when
# deploying. Never commit real values -- .env/.env.* are gitignored on purpose.

# --- Backend: LLM providers (config/agent_config.yaml defaults to deepseek) ---
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Backend: data sources ---
FOOTBALL_DATA_API_KEY=
ODDS_API_KEY=
ODDS_API_KEY_2=
ODDS_API_KEY_3=
TAVILY_API_KEY=
TAVILY_API_KEY_FALLBACK=

# A100: OddsPapi (oddspapi.io) -- distinct vendor from ODDS_API_KEY above
# (The Odds API). Used only by scripts/pull_oddspapi_btts_corners.py, a
# manual one-off historical BTTS/corners odds pull, not any automated
# pipeline. _2/_3 are additional keys tried in order once the current one's
# free-tier quota is spent (see that script's own docstring).
ODDSPAPI_API_KEY=
ODDSPAPI_API_KEY_2=
ODDSPAPI_API_KEY_3=

# --- Backend: deployment (W97) ---
# APP_ACCESS_TOKEN: once set, requests to /api/admin/* (only -- narrowed by
# W210, previously every route) must send a matching X-App-Token header, or
# get a 401. Leave unset for local dev -- only set this once the app is
# reachable from a public URL, and set NEXT_PUBLIC_APP_ACCESS_TOKEN (below)
# to the SAME value so the frontend can actually reach those admin routes.
# Pick any long random string.
APP_ACCESS_TOKEN=

# INTERNAL_API_SECRET (W210): a second, unrelated shared secret -- gates
# every /api/bets/* request instead of APP_ACCESS_TOKEN above. Verified by
# app/backend/auth_deps.py's get_current_user_email() against the
# X-Internal-Secret header. Must be set to the SAME value as
# app/frontend/.env.local's INTERNAL_API_SECRET (that file is where the
# frontend's other 5 multi-user-auth vars -- GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, NEXTAUTH_SECRET, NEXTAUTH_URL, ALLOWED_EMAILS --
# live too; they're Next.js-server-only and never read by this backend, so
# they aren't listed here). Never a real secret in this example file --
# pick any long random string, same as APP_ACCESS_TOKEN.
INTERNAL_API_SECRET=

# CORS_ALLOWED_ORIGINS: comma-separated list of frontend origins allowed to
# call this backend. Defaults to http://localhost:3000 (local dev) if unset.
# Set to your real deployed frontend URL, e.g. https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=

# ENABLE_SCHEDULER: off by default. Set to "1" to turn on the automated
# EOD/T-30 recommendation batch -- this makes real, paid LLM/odds API calls
# on a schedule, so only enable once you're ready for that cost/traffic.
ENABLE_SCHEDULER=

# --- Frontend (app/frontend) ---
# The backend's real URL once deployed, e.g. https://your-app.up.railway.app
NEXT_PUBLIC_API_BASE_URL=

# Same value as APP_ACCESS_TOKEN above -- only needed once that's set.
NEXT_PUBLIC_APP_ACCESS_TOKEN=
