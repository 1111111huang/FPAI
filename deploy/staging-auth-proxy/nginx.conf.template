# This is loaded by the official nginx image from /etc/nginx/conf.d/*
# The docker entrypoint below will envsubst this template to /etc/nginx/conf.d/reverse.conf
#
# Forked from biw/railway-nginx-password-auth (the Railway "Basic Auth Proxy"
# template) with one change: a CORS preflight (OPTIONS) request skips
# auth_basic. Browsers never attach credentials to a preflight -- that's the
# Fetch spec, not a bug to work around upstream -- so gating OPTIONS the same
# as every other method meant a credentialed cross-origin request could never
# succeed through this proxy: the preflight always 401'd and the browser gave
# up before ever sending the real request. The preflight is still proxied
# through to the upstream (not answered locally), so the upstream's own CORS
# logic -- the actual, single source of truth for which origins are allowed --
# is what answers it. The real (non-OPTIONS) request behind the preflight is
# still fully auth-gated, unchanged.
#
# Mechanism note: a first attempt used `if ($request_method = OPTIONS) {
# auth_basic off; }` to override the auth_basic set by the included
# basic_auth.conf snippet below -- confirmed live (curled the proxy directly,
# bypassing the browser entirely) that this does NOT work. nginx cannot
# reliably override auth_basic across two different config contexts
# (include vs. if) -- a known nginx limitation (trac.nginx.org/nginx/ticket/
# 2013), not something specific to this template or a syntax mistake.
# auth_basic instead takes its value from a single variable
# ($auth_basic_realm, computed once below): auth_basic has supported a
# variable argument since nginx 1.3.10 specifically for this per-request
# toggle use case, and there's only ever one textual auth_basic call in this
# config, so there's nothing left to "override."

server {
    listen 80;
    listen [::]:80;

    # Add DNS resolver - dynamically configured by entrypoint script
    resolver ${DNS_RESOLVER} valid=300s;
    resolver_timeout 5s;

    # Upstream is supplied via env var ORIGIN (e.g., http://app:3000)
    set $upstream "${ORIGIN}";

    # Basic hardening / sane defaults
    client_max_body_size 50m;

    # Proxy headers
    location / {
        # Default: no auth, so a deploy with no basic_auth.conf content at
        # all (ALLOW_NO_AUTH=true) still has $auth_basic_realm declared --
        # nginx needs at least one `set` for a custom variable to parse it.
        set $auth_basic_realm off;

        # May override $auth_basic_realm to the configured realm (and set
        # auth_basic_user_file) -- see docker-entrypoint.sh. Empty when
        # BASIC_AUTH isn't configured, leaving the default above in place.
        include /etc/nginx/snippets/basic_auth.conf;

        # See file header: a CORS preflight carries no credentials by spec,
        # so leaving auth_basic on would 401 it unconditionally and block
        # the real request from ever being sent.
        if ($request_method = OPTIONS) {
            set $auth_basic_realm off;
        }

        auth_basic $auth_basic_realm;

        proxy_http_version 1.1;

        # For HTTPS upstreams, we need to send the upstream host for SSL cert validation
        # Extract host from upstream URL for proper SSL handshake
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;

        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_pass $upstream;
    }
}

# Map for Connection header that works for both WS and regular HTTP
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
