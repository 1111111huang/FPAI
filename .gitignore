# 忽略虚拟环境
venv/
.venv/
env/

# 忽略 Python 缓存
__pycache__/
*.py[cod]

# 忽略数据和数据库（因为我们要的是代码，不是巨大的原始数据文件）
data/raw/football_data/*.csv
data/*.db
data/agent_snapshots/
reports/agent_backtest/

# 忽略 VS Code 配置
.vscode/

.DS_Store

mlruns/
.continue/rules/role-definition.md
CLAUDE.md

# Environment / secrets
.env
.env.*

# Local git worktrees (scratch space, never committed)
.claude/worktrees/

# Runtime logs (grow unbounded, not source)
data/logs/*.log

# Node (sandbox/ UI prototypes, future app/frontend)
node_modules/
.next/
out/
npm-debug.log*

# Claude Code skill-marketplace files (local tooling, not project source)
.agents/
.claude/skills/
skills-lock.json
