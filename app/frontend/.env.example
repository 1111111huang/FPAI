# Copy this file to .env.local for local dev (already gitignored) or paste
# these names into Vercel's "Environment Variables" dashboard when
# deploying. Never commit real values. See the repo-root .env.example for
# the backend's own vars (NEXT_PUBLIC_API_BASE_URL, NEXT_PUBLIC_APP_ACCESS_TOKEN
# there are the frontend-visible ones this app also reads).

# --- Google sign-in (W210) ---
# From a Google Cloud OAuth 2.0 Client ID (Web application), authorized
# redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth's own session secret -- signs/encrypts the JWT session cookie.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The canonical URL this app is served from. http://localhost:3000 for
# local dev; your real Vercel URL once deployed.
NEXTAUTH_URL=http://localhost:3000

# Comma-separated, case-insensitive allowlist of emails permitted to sign
# in (checked in lib/auth.ts's signIn callback). Invite-only -- anyone not
# listed here is rejected even after a successful Google login.
ALLOWED_EMAILS=

# Server-only secret (never sent to the browser) that authenticates this
# Next.js server's own proxy routes (app/api/bets/*, via
# lib/backendProxy.ts) to FastAPI -- distinct from NEXT_PUBLIC_APP_ACCESS_TOKEN
# above, which is public. Must match the backend's own INTERNAL_API_SECRET
# (repo-root .env) exactly. Pick any long random string.
INTERNAL_API_SECRET=
